# Python
__pycache__/
*.py[cod]
*.pyo

# Virtual environments
.venv/
venv/

# Environment variables / credentials
.env
.env.*

# Raw and processed data
data/raw/*
data/processed/*

# Keep directories even when empty
!data/raw/.gitkeep
!data/processed/.gitkeep

# Generated output
# Published teaching outputs are intentionally tracked.
# Keep this section available for future local-only generated artifacts.

# Runtime logs
logs/*
!logs/.gitkeep

# Temporary files
*.tmp
*.temp
~$*

# Jupyter
.ipynb_checkpoints/

# OS files
.DS_Store
Thumbs.db

# IDE / editor optional local state
.vscode/

# Runtime validation artifacts
validation/artifacts/*
!validation/artifacts/.gitkeep

# Generated AI reports
report/interpretation_prompt.txt
report/economic_interpretation.md

# Local workflow runtime state
workflow_state.json
